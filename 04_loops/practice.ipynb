   "source": [
    "# for문 기본\n",
    "\n",
    "medications = [\"아스피린\", \"메트포르민\", \"암로디핀\"]\n",
    "\n",
    "for med in medications:     # medications 리스트의 모든 값을 반복\n",
    "    print(f\"{med} 복용 확인\")  \n",
    "print(\"모든 약물 복용 확인 완료\")"
   ]
  }
